(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-fork)
(allow process-exec (literal (param "NODE")) (literal (param "CODEX")))
(allow file-read* file-map-executable (literal (param "NODE"))
       (subpath (param "PACKAGES")) (subpath "/System/Library") (subpath "/usr/lib"))
(allow file-read-metadata)
(allow file-read* file-write* (subpath (param "STATE")))
(allow file-read* (literal "/dev/urandom") (literal "/dev/random"))
(allow file-read* file-write* (literal "/dev/null"))
(allow sysctl-read)
